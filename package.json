{
  "name": "mazed",
  "version": "1.0.0",
  "description": "The idea is to build the Mazed app for PC, it will be built in react electron, so it's useable through web, app. mobile, while being highly customizable and alive",
  "main": "electron-main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "jest",
    "dist": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.yourcompany.mazed",
    "productName": "Mazed",
    "files": [
      "dist/**",
      "electron-main.js",
      "preload.js",
      "native/**",
      "runtime/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "native/**",
      "runtime/**"
    ],
    "mac": { "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "zip"] },
    "linux": { "target": ["AppImage", "deb"] },
    "directories": { "output": "release" }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "active-win": "^8.2.1",
    "color-namer": "^1.4.0",
    "compromise": "^14.14.4",
    "golden-layout": "^2.6.0",
    "jimp": "^0.22.12",
    "konva": "^9.3.22",
    "react": "^19.1.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.1.0",
    "react-easy-crop": "^5.0.1",
    "react-infinite-scroll-component": "^6.1.0",
    "react-konva": "^19.0.7",
    "reactflow": "^11.11.4",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.5.2",
    "@electron/rebuild": "4.0.1",
    "babel-jest": "^30.0.2",
    "concurrently": "^9.1.2",
    "electron": "^36.9.2",
    "electron-builder": "^26.0.12",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "react-test-renderer": "^19.1.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
